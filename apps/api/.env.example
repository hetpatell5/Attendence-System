# NestJS backend configuration — local development defaults.
# Copy to .env and adjust for your environment. Never commit the real .env.

NODE_ENV=development
PORT=3000

# Local dev: matches docker-compose.yml mysql service.
# Production: points at the CloudPanel-managed MySQL instance.
DATABASE_URL="mysql://attendance:attendance_dev_password@localhost:3306/attendance_dev"

# Comma-separated list of allowed origins for CORS (the Electron app's origin in dev/prod).
CORS_ORIGINS="http://localhost:5173"

# JWT access tokens signed with this secret. Generate a long random value in production
# (e.g. `openssl rand -hex 64`) — never reuse the example value.
JWT_SECRET="dev-only-access-secret-change-me"
JWT_ACCESS_EXPIRY="15m"

# Refresh tokens are opaque random values, NOT JWTs — they are looked up by their hash in the
# refresh_tokens table (so they can be revoked), not verified by signature. This secret is used
# as an HMAC pepper mixed into that hash, so a stolen database dump alone isn't enough to forge
# or replay a valid refresh token without also knowing this value.
JWT_REFRESH_SECRET="dev-only-refresh-pepper-change-me"
JWT_REFRESH_EXPIRY="7d"

# Used only by `pnpm prisma:seed` to create the initial SUPER_ADMIN account.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# One-off legacy data migration only (apps/api/scripts/legacy-migration).
# Points at the temporary Docker MySQL container started via
# `docker compose --profile legacy-migration up -d legacy-mysql`.
LEGACY_MYSQL_URL="mysql://root:legacy@localhost:3307/attensystem"
