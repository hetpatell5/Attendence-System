# ============================================================
# .env FOR OTHER PC ON SAME LOCAL NETWORK
# Replace this file's contents into apps/desktop/.env on the other PC
# ============================================================

# Points Electron's renderer and API calls to 192.168.1.39 (main server PC)
VITE_API_URL=http://192.168.1.39:3000

# Tells Electron's main process to load Vite from the main PC (not localhost)
VITE_DEV_SERVER_URL=http://192.168.1.39:5173
